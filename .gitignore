# Build output
/bin/
/dist/
*.tmp
*.test
*.out

# Built command binaries (produced by `go build` in cmd/*)
/catway
/catway2
/catctl
/cathost
/cmd/catway/catway
/cmd/catway2/catway2
/cmd/catctl/catctl
/cmd/cathost/cathost

# cats-todo's own backlog for this repo — personal working state that churns on
# every add/drop, not source. Each checkout keeps its own. The whole directory,
# not just todos.json: attachments land in .cats-todo/images/ and are the same
# category of local state.
.cats-todo/

# Docs build output and the python venv the mkdocs path needs (see
# requirements-docs.txt). The gkdocs path produces neither.
/site/
.venv/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Claude Code personal settings (shared settings.json is committed)
.claude/settings.local.json

# Local-only notes / session docs (never committed)
/ai_docs/local_only/

# Python
__pycache__/

# local toolchain (zig 0.15.2 for libghostty-vt build)
.tools/

# vendored libghostty-vt build outputs (rebuilt per checkout — the pkgconfig
# file bakes an absolute prefix at build time)
/third_party/libghostty-vt/zig-out/
/third_party/libghostty-vt/.zig-cache/
